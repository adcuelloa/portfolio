{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": false,
  "sortTailwindcss": {},
  "sortPackageJson": false,
  "sortImports": {
    "internalPattern": ["@/"],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true,
    "groups": [
      "side_effect",
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "astro": true,
  "ignorePatterns": ["node_modules", "dist", ".astro", ".wrangler", "pnpm-lock.yaml"]
}
