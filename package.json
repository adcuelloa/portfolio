{
  "name": "porfolio-dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/csp-audit.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "i18n:audit": "node scripts/i18n-audit.mjs --strict",
    "seo:audit": "node scripts/seo-audit.mjs",
    "hreflang:audit": "node scripts/hreflang-audit.mjs",
    "verify": "pnpm i18n:audit && pnpm seo:audit && pnpm build && pnpm hreflang:audit",
    "deploy": "pnpm build && wrangler deploy",
    "wrangler:types": "wrangler types",
    "csp:audit": "node scripts/csp-audit.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
