---
interface Props {
  label: string;
}

const { label } = Astro.props;
const maskId = `theme-mask-${crypto.randomUUID()}`;
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  class="text-ink-2 hover:bg-line/60 inline-flex size-11 items-center justify-center rounded-md"
>
  <span class="sr-only">{label}</span>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
  >
    <defs>
      <mask id={maskId} maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
        <rect width="24" height="24" fill="white" stroke="none" />
        <circle class="theme-cutout" cx="18" cy="6" r="8" fill="black" stroke="none" />
      </mask>
    </defs>
    <circle
      class="theme-disc"
      cx="12"
      cy="12"
      r="5"
      fill="currentColor"
      stroke="none"
      mask={`url(#${maskId})`}
    />
    <g class="theme-rays">
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </g>
  </svg>
</button>

<style>
  .theme-disc {
    r: var(--icon-radius, 5px);
  }
  .theme-cutout {
    transform: var(--icon-cutout, translate(12px, -12px));
  }
  .theme-rays {
    transform-origin: 12px 12px;
    opacity: var(--icon-rays-opacity, 1);
    transform: var(--icon-rays-transform, none);
  }

  :global(:root[data-theme="dark"]) svg {
    --icon-radius: 8px;
    --icon-cutout: translate(0, 0);
    --icon-rays-opacity: 0;
    --icon-rays-transform: rotate(45deg) scale(0.5);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) svg {
      --icon-radius: 8px;
      --icon-cutout: translate(0, 0);
      --icon-rays-opacity: 0;
      --icon-rays-transform: rotate(45deg) scale(0.5);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .theme-disc {
      transition: r 350ms ease-in-out;
    }
    .theme-cutout {
      transition: transform 350ms ease-in-out;
    }
    .theme-rays {
      transition:
        transform 350ms ease-in-out,
        opacity 200ms ease-in-out;
    }
  }
</style>

<script>
  // Runs once per page load (including client-router swaps) and cleans up before the next swap.
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  let cleanup: (() => void) | undefined;
  let activeTransition: ViewTransition | undefined;

  function stopTransition() {
    activeTransition?.skipTransition();
    activeTransition = undefined;
    delete document.documentElement.dataset.themeTransition;
  }

  function init() {
    cleanup?.();
    const root = document.documentElement;
    const isDark = () =>
      root.dataset.theme === "dark" || (root.dataset.theme !== "light" && media.matches);
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")];
    const sync = () => buttons.forEach((b) => b.setAttribute("aria-pressed", String(isDark())));
    const apply = (next: "light" | "dark") => {
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Storage can be unavailable (private mode); the choice still applies to this page.
      }
      sync();
    };

    // Circular reveal from the icon centre. Falls back to an
    // instant switch without the View Transitions API or when reduced motion is preferred.
    const toggle = (event: MouseEvent) => {
      if (activeTransition) return;
      const next = isDark() ? "light" : "dark";
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!document.startViewTransition || reduce) return apply(next);

      const button = event.currentTarget as HTMLElement;
      const rect = button.querySelector("svg")!.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      root.style.setProperty("--theme-x", `${x}px`);
      root.style.setProperty("--theme-y", `${y}px`);
      root.dataset.themeTransition = "";
      const transition = document.startViewTransition(() => apply(next));
      activeTransition = transition;
      transition.ready.catch(() => undefined);
      transition.finished
        .catch(() => undefined)
        .finally(() => {
          if (activeTransition === transition) stopTransition();
        });
    };

    sync();
    media.addEventListener("change", sync);
    buttons.forEach((b) => b.addEventListener("click", toggle));
    cleanup = () => {
      media.removeEventListener("change", sync);
      buttons.forEach((b) => b.removeEventListener("click", toggle));
    };
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-preparation", stopTransition);
  document.addEventListener("astro:before-swap", () => cleanup?.());
  window.addEventListener("pagehide", stopTransition);
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) return;
    stopTransition();
    try {
      const theme = localStorage.getItem("theme");
      if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
    } catch {}
    init();
  });
</script>
