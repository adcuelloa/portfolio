---
interface Props {
  eyebrow: string;
  title: string;
  id: string;
}

const { eyebrow, title, id } = Astro.props;
---

<div class="flex flex-col gap-3">
  <p class="eyebrow flex items-center gap-3">
    <span aria-hidden="true" class="bg-accent h-px w-8"></span>
    <span>{eyebrow}</span>
  </p>
  <h2
    id={id}
    class="text-[2rem] leading-[1.1] font-bold tracking-[-0.02em] text-balance sm:text-[2.5rem]"
  >
    {title}
  </h2>
</div>
