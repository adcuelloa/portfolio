---
interface Props {
  /** Two-digit index, e.g. "01"; gives the page its editorial rhythm. */
  index: string;
  eyebrow: string;
  title: string;
  id: string;
}

const { index, eyebrow, title, id } = Astro.props;
---

<div class="flex flex-col gap-3">
  <p class="eyebrow flex items-center gap-3">
    <span class="text-accent-ink">{index}</span>
    <span aria-hidden="true" class="h-px w-8 bg-line-strong"></span>
    <span>{eyebrow}</span>
  </p>
  <h2 id={id} class="text-[2rem] leading-[1.1] font-bold tracking-[-0.02em] text-balance sm:text-[2.5rem]">
    {title}
  </h2>
</div>
