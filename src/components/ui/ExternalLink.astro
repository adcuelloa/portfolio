---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & { href: string };

const { class: className, ...rest } = Astro.props;
---

<a
  {...rest}
  class:list={[
    "group text-accent-ink decoration-line-strong hover:decoration-accent inline-flex min-h-11 items-center gap-1.5 font-medium underline",
    className,
  ]}
>
  <slot />
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    width="14"
    height="14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
  >
    <path d="M5 11 11 5M6 5h5v5"></path>
  </svg>
</a>
