---
import type { CollectionEntry } from "astro:content";

import ExternalLink from "@/components/ui/ExternalLink.astro";
import KindBadge from "@/components/ui/KindBadge.astro";
import type { Locale } from "@/i18n/routes";
import { useTranslations } from "@/i18n/utils";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Locale;
  caseStudyHref?: string;
}

const { project, lang, caseStudyHref } = Astro.props;
const { data } = project;
const t = useTranslations(lang);
const titleId = `project-${project.id.replace(/\W+/g, "-")}`;

const statusLabel = data.status
  ? {
      live: t("common.status.live"),
      development: t("common.status.development"),
      experimental: t("common.status.experimental"),
    }[data.status]
  : undefined;
---

<article
  aria-labelledby={titleId}
  class="grid gap-x-10 gap-y-4 rounded-xl border border-line p-5 sm:p-8 lg:grid-cols-12"
>
  <div class="flex flex-col gap-3 lg:col-span-4">
    <h4
      id={titleId}
      class="text-[1.5rem] leading-tight font-bold tracking-[-0.015em]"
    >
      {data.title}
    </h4>
    <div class="flex flex-wrap items-center gap-2">
      <KindBadge kind={data.kind} lang={lang} />
      {statusLabel && <span class="kind kind-neutral">{statusLabel}</span>}
    </div>
  </div>

  <div class="flex flex-col gap-3 lg:col-span-5">
    <p class="text-[1rem] leading-relaxed text-ink-2">{data.summary}</p>
    <p class="text-[0.875rem] leading-relaxed text-muted">{data.statusNote}</p>
  </div>

  <div class="flex flex-col gap-2 lg:col-span-3">
    <p class="font-mono text-[0.8125rem] leading-relaxed text-ink-2">
      {data.stack.join(" · ")}
    </p>
    <div class="flex flex-wrap gap-x-6">
      {
        caseStudyHref && (
          <a
            href={caseStudyHref}
            class="inline-flex min-h-11 items-center font-medium text-accent-ink"
          >
            {t("common.links.caseStudy")} →
          </a>
        )
      }
      {
        data.links.live && (
          <ExternalLink href={data.links.live}>
            {t("common.links.visit")}
          </ExternalLink>
        )
      }
      {
        data.links.repository && (
          <ExternalLink href={data.links.repository}>
            {t("common.links.repository")}
          </ExternalLink>
        )
      }
    </div>
  </div>
</article>
