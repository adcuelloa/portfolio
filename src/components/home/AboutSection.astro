---
import { Image } from "astro:assets";

import SectionHeading from "@/components/ui/SectionHeading.astro";
import { sectionIds, type Locale } from "@/i18n/routes";
import { ui, useTranslations } from "@/i18n/utils";
import { cdn } from "@/lib/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const paragraphs = ui[lang].home.about.paragraphs;
---

<section id={sectionIds.about[lang]} aria-labelledby="about-title" class="mx-auto w-full max-w-[1200px] scroll-mt-6 px-4 pb-24 sm:px-8 lg:px-12">
  <div class="grid gap-10 border-t border-line pt-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <SectionHeading index="05" eyebrow={t("home.about.eyebrow")} title={t("home.about.title")} id="about-title" />
    </div>
    <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start lg:col-span-7">
      <div class="flex flex-col gap-5 text-[1.0625rem] leading-relaxed text-ink-2 sm:text-[1.125rem]">
        {paragraphs.map((paragraph) => <p class="max-w-[58ch]">{paragraph}</p>)}
      </div>
      <Image
        src={cdn("me.webp")}
        alt={t("home.about.portraitAlt")}
        width={360}
        height={360}
        widths={[180, 360]}
        sizes="180px"
        class="size-[180px] shrink-0 rounded-xl border border-line object-cover"
      />
    </div>
  </div>
</section>
