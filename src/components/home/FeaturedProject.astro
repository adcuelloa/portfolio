---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import ExternalLink from "@/components/ui/ExternalLink.astro";
import KindBadge from "@/components/ui/KindBadge.astro";
import type { Locale } from "@/i18n/routes";
import { useTranslations } from "@/i18n/utils";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Locale;
  index: number;
  caseStudyHref?: string;
}

const { project, lang, index, caseStudyHref } = Astro.props;
const { data } = project;
const t = useTranslations(lang);
const reversed = index % 2 === 1;
const titleId = `project-${project.id.replace(/\W+/g, "-")}`;

const statusLabel = data.status
  ? {
      live: t("common.status.live"),
      development: t("common.status.development"),
      experimental: t("common.status.experimental"),
    }[data.status]
  : undefined;
---

<article
  aria-labelledby={titleId}
  class="border-line grid items-start gap-8 rounded-xl border p-5 sm:p-8 lg:grid-cols-12 lg:gap-12"
>
  {data.image && data.imageAlt && (
    <figure class:list={["flex flex-col gap-3 lg:col-span-7", reversed && "lg:order-2"]}>
      <div class="border-line bg-surface overflow-hidden rounded-xl border shadow-[0_1px_0_var(--line),0_24px_48px_-32px_rgb(0_0_0/0.35)]">
        <Image
          src={data.image}
          alt={data.imageAlt}
          width={1440}
          height={900}
          widths={[480, 720, 960, 1440]}
          sizes="(min-width: 1200px) 640px, (min-width: 1024px) 56vw, 100vw"
          class="aspect-16/10 h-auto w-full object-cover object-top"
        />
      </div>
      <figcaption class="flex flex-col gap-1.5">
        <span class="eyebrow">
          {t("home.work.screenshotOf")} {data.imageSource}
        </span>
        {data.illustrativeMockup && (
          <span class="text-muted flex gap-2 text-[0.8125rem] leading-relaxed">
            <span aria-hidden="true" class="text-accent-ink font-mono">
              *
            </span>
            {t("home.work.mockupNote")}
          </span>
        )}
      </figcaption>
    </figure>
  )}

  <div class:list={["flex flex-col gap-5 lg:col-span-5", reversed && "lg:order-1"]}>
    <div class="flex flex-wrap items-center gap-2">
      <KindBadge kind={data.kind} lang={lang} />
      {statusLabel && <span class="kind kind-neutral">{statusLabel}</span>}
    </div>
    <h3 id={titleId} class="text-[1.875rem] leading-tight font-bold tracking-[-0.02em]">
      {data.title}
    </h3>
    <p class="text-ink-2 text-[1.0625rem] leading-relaxed">{data.summary}</p>

    {data.highlights.length > 0 && (
      <ul class="text-ink-2 flex flex-col gap-2.5 text-[0.9375rem] leading-relaxed">
        {data.highlights.map((item) => (
          <li class="grid grid-cols-[1rem_1fr] gap-2">
            <span aria-hidden="true" class="pt-[0.6em]">
              <span class="bg-accent block h-px w-3" />
            </span>
            {item}
          </li>
        ))}
      </ul>
    )}

    <dl class="border-line flex flex-col gap-3 border-t pt-4 text-[0.9375rem]">
      <div class="grid gap-1 sm:grid-cols-[7.5rem_1fr] sm:gap-4">
        <dt class="eyebrow pt-0.5">{t("home.work.statusLabel")}</dt>
        <dd class="leading-relaxed">{data.statusNote}</dd>
      </div>
      <div class="grid gap-1 sm:grid-cols-[7.5rem_1fr] sm:gap-4">
        <dt class="eyebrow pt-0.5">{t("home.work.builtLabel")}</dt>
        <dd class="text-ink-2 font-mono text-[0.8125rem] leading-relaxed">
          {data.stack.join(" · ")}
        </dd>
      </div>
    </dl>

    <div class="flex flex-wrap gap-x-6">
      {caseStudyHref && (
        <a
          href={caseStudyHref}
          class="text-accent-ink inline-flex min-h-11 items-center font-medium"
        >
          {t("common.links.caseStudy")} →
        </a>
      )}
      {data.links.live && (
        <ExternalLink href={data.links.live}>{t("common.links.visit")}</ExternalLink>
      )}
      {data.links.repository && (
        <ExternalLink href={data.links.repository}>{t("common.links.repository")}</ExternalLink>
      )}
    </div>
  </div>
</article>
