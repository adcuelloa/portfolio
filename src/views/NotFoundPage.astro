---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localizedPath, otherLocale, type Locale } from "@/i18n/routes";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  seo={{
    title: t("seo.notFound.title"),
    description: t("seo.notFound.description"),
    noindex: true,
  }}
  languageHref={localizedPath(otherLocale(lang), "home")}
>
  <section
    class="mx-auto flex w-full max-w-300 flex-col gap-6 px-4 py-24 sm:px-8 sm:py-36 lg:px-12"
  >
    <p class="eyebrow">404</p>
    <h1
      class="max-w-[18ch] text-[2.5rem] leading-[1.05] font-bold tracking-[-0.03em] sm:text-[3.5rem]"
    >
      {t("common.notFound.heading")}
    </h1>
    <p class="max-w-[52ch] text-[1.125rem] leading-relaxed text-ink-2">
      {t("common.notFound.body")}
    </p>
    <a
      href={localizedPath(lang, "home")}
      class="inline-flex min-h-12 items-center self-start rounded-lg bg-ink px-5 font-medium text-paper no-underline hover:bg-ink-2"
    >
      {t("common.notFound.home")}
    </a>
  </section>
</BaseLayout>
