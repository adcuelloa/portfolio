---
import { localizedPath, otherLocale, type Locale } from "@/i18n/routes";
import { useTranslations } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  seo={{
    title: t("seo.notFound.title"),
    description: t("seo.notFound.description"),
    noindex: true,
  }}
  languageHref={localizedPath(otherLocale(lang), "home")}
>
  <section class="mx-auto flex w-full max-w-300 flex-col gap-6 px-4 py-24 sm:px-8 sm:py-36 lg:px-12">
    <p class="eyebrow">404</p>
    <h1 class="max-w-[18ch] text-[2.5rem] leading-[1.05] font-bold tracking-[-0.03em] sm:text-[3.5rem]">
      {t("common.notFound.heading")}
    </h1>
    <p class="text-ink-2 max-w-[52ch] text-[1.125rem] leading-relaxed">
      {t("common.notFound.body")}
    </p>
    <a
      href={localizedPath(lang, "home")}
      class="bg-ink text-paper hover:bg-ink-2 inline-flex min-h-12 items-center self-start rounded-lg px-5 font-medium no-underline"
    >
      {t("common.notFound.home")}
    </a>
  </section>
</BaseLayout>
