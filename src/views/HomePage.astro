---
import AboutSection from "@/components/home/AboutSection.astro";
import CapabilitiesSection from "@/components/home/CapabilitiesSection.astro";
import ContactSection from "@/components/home/ContactSection.astro";
import ExperienceSection from "@/components/home/ExperienceSection.astro";
import Hero from "@/components/home/Hero.astro";
import WorkSection from "@/components/home/WorkSection.astro";
import WritingSection from "@/components/home/WritingSection.astro";
import { alternateLinks, type Locale } from "@/i18n/routes";
import { useTranslations } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { personSchema, websiteSchema } from "@/lib/seo";
import { SITE } from "@/lib/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(SITE.url);
const description = t("seo.home.description");
---

<BaseLayout
  seo={{
    title: t("seo.home.title"),
    description,
    alternates: alternateLinks("home", site),
    structuredData: [personSchema(lang, description), websiteSchema(lang, description)],
  }}
>
  <Hero lang={lang} />
  <WorkSection lang={lang} />
  <CapabilitiesSection lang={lang} />
  <ExperienceSection lang={lang} />
  <WritingSection lang={lang} />
  <AboutSection lang={lang} />
  <ContactSection lang={lang} />
</BaseLayout>
