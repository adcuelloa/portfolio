---
import "@fontsource-variable/schibsted-grotesk/wght.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@/styles/global.css";

import sansWoff2 from "@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url";
import monoWoff2 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import { ClientRouter } from "astro:transitions";

import Footer from "@/components/site/Footer.astro";
import Header from "@/components/site/Header.astro";
import { defaultLocale, type Alternate } from "@/i18n/routes";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { defaultOgImage, jsonLdScript, ogLocales, type SeoMeta } from "@/lib/seo";
import { SITE } from "@/lib/site";

interface Props {
  seo: SeoMeta;
  /** Alternate-language path for the header language link; defaults to the matching alternate. */
  languageHref?: string;
}

const { seo, languageHref } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const site = Astro.site ?? new URL(SITE.url);

// `build.format: "file"` emits `/es.html`; the public URL has no extension and no trailing slash.
const pathname = Astro.url.pathname
  .replace(/\/index(\.html)?$/, "/")
  .replace(/\.html$/, "")
  .replace(/(.)\/$/, "$1");
const pageUrl = new URL(pathname, site).href;
const canonical = seo.noindex ? undefined : pageUrl;

const alternates: Alternate[] = seo.noindex ? [] : (seo.alternates ?? []);
const xDefault = alternates.find((a) => a.hreflang === defaultLocale)?.href;
const ogImage = seo.image?.url ?? defaultOgImage(lang);
const ogLocaleAlternates = alternates
  .filter((a) => a.hreflang !== lang)
  .map((a) => ogLocales[a.hreflang]);

// Root-relative so the switch stays on the current host (localhost, previews), unlike the absolute hreflang URLs.
const alternateHref = alternates.find((a) => a.hreflang !== lang)?.href;
const otherLanguageHref =
  languageHref ?? (alternateHref ? new URL(alternateHref).pathname : undefined);
const structuredData = jsonLdScript(seo.structuredData ?? []);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        var stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark")
          document.documentElement.dataset.theme = stored;
      } catch (_) {}
    </script>
    <ClientRouter />
    <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href={SITE.cdnUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1211" />
    <meta name="generator" content={Astro.generator} />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content={SITE.name} />
    <meta
      name="robots"
      content={seo.noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={seo.ogType ?? "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {seo.image?.alt && <meta property="og:image:alt" content={seo.image.alt} />}
    <meta property="og:locale" content={ogLocales[lang]} />
    {ogLocaleAlternates.map((locale) => (
      <meta property="og:locale:alternate" content={locale} />
    ))}
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.updatedTime && <meta property="article:modified_time" content={seo.updatedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content={SITE.twitter} />

    <Fragment set:html={structuredData} />
  </head>

  <body class="bg-paper text-ink">
    <a
      href="#main"
      class="focus:bg-ink focus:text-paper sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:px-4 focus:py-3"
    >
      {t("common.skip")}
    </a>
    <Header lang={lang} languageHref={otherLanguageHref} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import { initPageLifecycle } from "@/lib/pageLifecycle";

      initPageLifecycle();
    </script>
  </body>
</html>
